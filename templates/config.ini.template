[paddles]
base_url = http://paddles.example.com
timeout = 60
tls_verify = <true|false|1|0>

[pulpito]
base_url = http://pulpito.example.com

[nightly]
run_user = jenkins-build

[cache]
# Background catalog refresh interval in minutes, aligned to the UTC clock
# (60 = every hour at :00).
refresh_minutes = 60

[release]
branches = main, umbrella, tentacle, squid

[llm]
base_url = https://api.example.com/v1
model = your-model-id
api_key = your-api-key
; timeout = 600
; max_tokens = 4096
; context_length = 65536
