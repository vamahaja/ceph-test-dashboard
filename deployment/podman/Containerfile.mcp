# syntax=docker/dockerfile:1
FROM python:3.14-slim AS build

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

COPY pyproject.toml ./

RUN --mount=type=cache,target=/root/.cache/uv \
    uv lock && uv sync --no-install-project --no-dev

COPY llm/mcp/mcp.py ./llm/mcp/
COPY libs/ ./libs/

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --no-dev

FROM python:3.14-slim AS runtime

# HOME is fixed so config paths resolve the same way under
# Podman, Docker, and orchestrators that may override the process UID.
ENV PATH="/app/.venv/bin:$PATH" \
    HOME=/home/appuser \
    CEPH_TEST_DASHBOARD_CONFIG=/home/appuser/.config/ceph-test-dashboard.ini

RUN apt-get update && apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd -g 1001 appgroup && \
    useradd -u 1001 -g appgroup -m -d /home/appuser -s /bin/false appuser && \
    mkdir -p /home/appuser/.config && \
    chown -R 1001:0 /home/appuser && \
    chmod -R g=u /home/appuser

WORKDIR /app

COPY --from=build --chown=1001:0 /app .

# Writable by the default image user (1001) and by any assigned non-root
# UID that shares the root group (common in Kubernetes-style runtimes /
# OpenShift).
RUN chgrp -R 0 /app /home/appuser && chmod -R g=u /app /home/appuser

USER 1001

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:8000/sse || exit 1

ENTRYPOINT ["python", "llm/mcp/mcp.py"]
CMD ["--transport", "sse", "--host", "0.0.0.0", "--port", "8000"]
